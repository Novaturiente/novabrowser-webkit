+// novabrowser: Dark Reader's dynamic-theme colour maps (MIT, github.com/darkreader/darkreader,
+// src/inject/dynamic-theme/modify-colors.ts: modifyBgHSL, modifyFgHSL, modifyBorderHSL) with
+// its default dark theme (background #181a1b, text #e8e6e3, brightness/contrast 100, no sepia
+// or grayscale, so its final colour matrix is the identity).
+namespace DarkReader {
+
+// double, like Dark Reader's JS numbers (float flips the l < 0.2 / s < 0.24 thresholds)
+struct HSLA { double h, s, l, a; };
+
+static double scale(double x, double inLow, double inHigh, double outLow, double outHigh)
+{
+    return (x - inLow) * (outHigh - outLow) / (inHigh - inLow) + outLow;
+}
+
+static HSLA toHSL(double r, double g, double b, double a)
+{
+    auto [min, max] = std::minmax({ r, g, b });
+    double c = max - min;
+    double l = (max + min) / 2;
+    if (!c)
+        return { 0, 0, l, a };
+    double h = (max == r ? std::fmod((g - b) / c, 6.0) : max == g ? (b - r) / c + 2 : (r - g) / c + 4) * 60;
+    if (h < 0)
+        h += 360;
+    return { h, c / (1 - std::abs(2 * l - 1)), l, a };
+}
+
+static SRGBA<float> fromHSL(const HSLA& x)
+{
+    double c = (1 - std::abs(2 * x.l - 1)) * x.s;
+    double y = c * (1 - std::abs(std::fmod(x.h / 60, 2.0) - 1));
+    double m = x.l - c / 2;
+    double r = 0, g = 0, b = 0;
+    if (x.h < 60) { r = c; g = y; }
+    else if (x.h < 120) { r = y; g = c; }
+    else if (x.h < 180) { g = c; b = y; }
+    else if (x.h < 240) { g = y; b = c; }
+    else if (x.h < 300) { r = y; b = c; }
+    else { r = c; b = y; }
+    auto clamp = [](double v) { return static_cast<float>(std::clamp(v, 0.0, 1.0)); };
+    return { clamp(r + m), clamp(g + m), clamp(b + m), static_cast<float>(x.a) };
+}
+
+static const HSLA& bgPole()
+{
+    static const HSLA pole = toHSL(0x18 / 255.0, 0x1a / 255.0, 0x1b / 255.0, 1);
+    return pole;
+}
+
+static const HSLA& fgPole()
+{
+    static const HSLA pole = toHSL(0xe8 / 255.0, 0xe6 / 255.0, 0xe3 / 255.0, 1);
+    return pole;
+}
+
+static HSLA background(HSLA x)
+{
+    constexpr double maxBgLightness = 0.4;
+    auto& pole = bgPole();
+    bool isDark = x.l < 0.5;
+    bool isBlue = x.h > 200 && x.h < 280;
+    bool isNeutral = x.s < 0.12 || (x.l > 0.8 && isBlue);
+    if (isDark) {
+        double lx = scale(x.l, 0, 0.5, 0, maxBgLightness);
+        if (isNeutral)
+            return { pole.h, pole.s, lx, x.a };
+        return { x.h, x.s, lx, x.a };
+    }
+    double lx = scale(x.l, 0.5, 1, maxBgLightness, pole.l);
+    if (isNeutral)
+        return { pole.h, pole.s, lx, x.a };
+    double hx = x.h;
+    if (x.h > 60 && x.h < 180)
+        hx = x.h > 120 ? scale(x.h, 120, 180, 135, 180) : scale(x.h, 60, 120, 60, 105);
+    // lower the lightness when the result is in the lower yellow spectrum
+    if (hx > 40 && hx < 80)
+        lx *= 0.75;
+    return { hx, x.s, lx, x.a };
+}
+
+static HSLA foreground(HSLA x)
+{
+    constexpr double minFgLightness = 0.55;
+    auto& pole = fgPole();
+    auto blueHue = [](double h) { return scale(h, 205, 245, 205, 220); };
+    bool isLight = x.l > 0.5;
+    bool isNeutral = x.l < 0.2 || x.s < 0.24;
+    bool isBlue = !isNeutral && x.h > 205 && x.h < 245;
+    if (isLight) {
+        double lx = scale(x.l, 0.5, 1, minFgLightness, pole.l);
+        if (isNeutral)
+            return { pole.h, pole.s, lx, x.a };
+        return { isBlue ? blueHue(x.h) : x.h, x.s, lx, x.a };
+    }
+    if (isNeutral)
+        return { pole.h, pole.s, scale(x.l, 0, 0.5, pole.l, minFgLightness), x.a };
+    if (isBlue)
+        return { blueHue(x.h), x.s, scale(x.l, 0, 0.5, pole.l, std::min(1.0, minFgLightness + 0.05)), x.a };
+    return { x.h, x.s, scale(x.l, 0, 0.5, pole.l, minFgLightness), x.a };
+}
+
+static HSLA border(HSLA x)
+{
+    bool isDark = x.l < 0.5;
+    bool isNeutral = x.l < 0.2 || x.s < 0.24;
+    double hx = x.h, sx = x.s;
+    if (isNeutral) {
+        auto& pole = isDark ? fgPole() : bgPole();
+        hx = pole.h;
+        sx = pole.s;
+    }
+    return { hx, sx, scale(x.l, 0, 1, 0.5, 0.2), x.a };
+}
