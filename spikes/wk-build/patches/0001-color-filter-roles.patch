+template<typename ColorTraits> constexpr ColorFilterRole colorFilterRoleFor()
+{
+    if constexpr (std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBackgroundColor>>>)
+        return ColorFilterRole::Background;
+    else if constexpr (std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyWebkitTextFillColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyWebkitTextStrokeColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyCaretColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyTextDecorationColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyTextEmphasisColor>>>)
+        return ColorFilterRole::Foreground;
+    else
+        return ColorFilterRole::Any;
+}
