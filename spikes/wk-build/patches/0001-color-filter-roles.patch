+template<typename ColorTraits> constexpr ColorFilterRole colorFilterRoleFor()
+{
+    // as Dark Reader picks by property name: background -> background, border/outline -> border
+    if constexpr (std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBackgroundColor>>>)
+        return ColorFilterRole::Background;
+    else if constexpr (std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBorderTopColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBorderRightColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBorderBottomColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyBorderLeftColor>>>
+        || std::same_as<ColorTraits, ColorPropertyTraits<PropertyNameConstant<CSSPropertyOutlineColor>>>)
+        return ColorFilterRole::Border;
+    else
+        return ColorFilterRole::Foreground;
+}
