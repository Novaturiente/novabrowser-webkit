+WebCore::Color ColorResolver::colorApplyingColorFilter(const WebCore::Color& color, ColorFilterRole role) const
+{
+    auto transformedColor = colorApplyingColorFilter(color);
+    if (role == ColorFilterRole::Background && transformedColor.luminance() > color.luminance())
+        return color;
+    if (role == ColorFilterRole::Foreground && transformedColor.luminance() < color.luminance())
+        return color;
+    return transformedColor;
+}
+
+WebCore::Color ColorResolver::colorResolvingCurrentColorApplyingColorFilter(const Style::Color& color, ColorFilterRole role) const
+{
+    return colorApplyingColorFilter(colorResolvingCurrentColor(color), role);
+}
+
 WebCore::Color ColorResolver::colorResolvingCurrentColor(const Style::Color& color) const
 {
     return color.resolveColor(m_style->color());
