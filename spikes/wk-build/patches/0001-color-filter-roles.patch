+// Every `-apple-color-filter` value gets Dark Reader's map for the colour's role (we only ever
+// set `apple-invert-lightness()`). System colours (`CanvasText`, `Field`, ...) are left alone as
+// in WebKit's filter: the browser's dark-mode style also sets `color-scheme: dark`, so they and
+// the natively drawn form controls are already dark. shortcut: inverseTransformColor (pasting
+// into filtered editable content) still undoes WebKit's own matrix, not this map; fix if paste
+// colours matter.
+WebCore::Color ColorResolver::colorApplyingColorFilter(const WebCore::Color& color, ColorFilterRole role) const
+{
+    if (m_style->appleColorFilter().isNone() || !color.isValid() || color.isSemantic())
+        return color;
+    // from 8-bit channels, as Dark Reader parses CSS colours
+    auto [r, g, b, a] = asColorComponents(color.toColorTypeLossy<SRGBA<uint8_t>>().resolved());
+    auto hsl = DarkReader::toHSL(r / 255.0, g / 255.0, b / 255.0, a / 255.0);
+    auto mapped = role == ColorFilterRole::Background ? DarkReader::background(hsl)
+        : role == ColorFilterRole::Border ? DarkReader::border(hsl)
+        : DarkReader::foreground(hsl);
+    return convertColor<SRGBA<uint8_t>>(DarkReader::fromHSL(mapped));
+}
