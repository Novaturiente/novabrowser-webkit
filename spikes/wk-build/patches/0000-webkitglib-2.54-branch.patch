+
+const ClassInfo JSWebAssemblySuspendingWrapper::s_info = { "WebAssembly.Suspending"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(JSWebAssemblySuspendingWrapper) };
+
+JSWebAssemblySuspendingWrapper::JSWebAssemblySuspendingWrapper(VM& vm, Structure* structure)
+    : Base(vm, structure)
+{
+}
+
+JSWebAssemblySuspendingWrapper* JSWebAssemblySuspendingWrapper::create(VM& vm, Structure* structure, JSObject* wrappedFunction)
+{
+    auto* wrapper = new (NotNull, allocateCell<JSWebAssemblySuspendingWrapper>(vm)) JSWebAssemblySuspendingWrapper(vm, structure);
+    wrapper->finishCreation(vm, wrappedFunction);
+    return wrapper;
+}
+
+Structure* JSWebAssemblySuspendingWrapper::createStructure(VM& vm, JSGlobalObject* globalObject, JSValue prototype)
+{
+    return Structure::create(vm, globalObject, prototype, TypeInfo(ObjectType, StructureFlags), info());
+}
+
+void JSWebAssemblySuspendingWrapper::finishCreation(VM& vm, JSObject* wrappedFunction)
+{
+    Base::finishCreation(vm);
+    ASSERT(inherits(info()));
+    m_wrappedFunction.set(vm, this, wrappedFunction);
+}
+
+template<typename Visitor>
+void JSWebAssemblySuspendingWrapper::visitChildrenImpl(JSCell* cell, Visitor& visitor)
+{
+    auto* thisObject = uncheckedDowncast<JSWebAssemblySuspendingWrapper>(cell);
+    ASSERT_GC_OBJECT_INHERITS(thisObject, info());
+
+    Base::visitChildren(thisObject, visitor);
+    visitor.append(thisObject->m_wrappedFunction);
+}
+
+DEFINE_VISIT_CHILDREN(JSWebAssemblySuspendingWrapper);
+
+} // namespace JSC
