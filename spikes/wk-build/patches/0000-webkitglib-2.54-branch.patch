+sk_sp<SkImage> scaleImagePixels(const sk_sp<SkImage>& image, const IntSize& scaledSize)
+{
+    auto imageInfo = SkImageInfo::Make(scaledSize.width(), scaledSize.height(), image->imageInfo().colorType(), image->imageInfo().alphaType());
