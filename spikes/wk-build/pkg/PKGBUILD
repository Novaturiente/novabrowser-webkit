# Packages the PGO + x86-64-v3 + ThinLTO WebKitGTK built by ../build.sh pkg (staged in
# ~/wk-build/stage-pkg on novahome). No build() here: the build must run in the original
# source dir to keep the PGO profile matching (see build.sh).
# AVX2 (x86-64-v3) CPUs only. Back to Arch's build:
#   sudo pacman -U /var/cache/pacman/pkg/webkitgtk-6.0-2.54.2-1-x86_64.pkg.tar.zst
pkgname=webkitgtk-6.0-nova
pkgver=2.54.2
pkgrel=1
pkgdesc="Web content engine for GTK (PGO + x86-64-v3 + ThinLTO build, no introspection/docs)"
url="https://webkitgtk.org"
arch=(x86_64)
license=('LGPL-2.1-or-later' 'BSD-2-Clause')
depends=(at-spi2-core atk bubblewrap cairo enchant expat fontconfig freetype2 gdk-pixbuf2
  glib2 glibc gst-plugins-bad-libs gst-plugins-base-libs gstreamer gtk4 harfbuzz harfbuzz-icu
  hyphen icu lcms2 libatomic libavif libdrm libegl libepoxy libgcc libgcrypt libgl libgles
  libjpeg-turbo libjxl libmanette libpng libseccomp libsecret libsoup3 libstdc++ libsystemd
  libtasn1 libwebp libx11 libxml2 libxslt mesa openjpeg2 pango sqlite ttf-font wayland woff2
  xdg-dbus-proxy zlib)
optdepends=('geoclue: Geolocation support'
  'gst-libav: nonfree media decoding'
  'gst-plugins-bad: media decoding'
  'gst-plugins-good: media decoding')
provides=("webkitgtk-6.0=$pkgver" libjavascriptcoregtk-6.0.so libwebkitgtk-6.0.so)
conflicts=(webkitgtk-6.0)
options=(strip !lto !debug)

package() {
  cp -a "$HOME/wk-build/stage-pkg/." "$pkgdir/"
  cd "$HOME/wk-build/webkitgtk-$pkgver"
  find Source -name 'COPYING*' -or -name 'LICENSE*' -print0 | sort -z |
    while IFS= read -d $'\0' -r _f; do echo "### $_f ###"; cat "$_f"; echo; done |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
