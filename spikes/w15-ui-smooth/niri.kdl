// Nested niri for flash.sh: an isolated output, so the recording only ever sees the browser.
animations { off; }
hotkey-overlay { skip-at-startup; }
prefer-no-csd
layout {
    gaps 0
    focus-ring { off; }
    border { off; }
    default-column-width { proportion 1.0; }
}
window-rule {
    open-maximized true
}
